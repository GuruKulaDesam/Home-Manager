#!/bin/sh

message_file="$1"
commit_source="${2:-}"

# Reusing an existing message (amend, merge, squash, -c/-C) must not create a
# second version for the same logical commit.
case "$commit_source" in
  commit|merge|squash) exit 0 ;;
esac

next_version=$(git show :VERSION 2>/dev/null || printf '1.0.0')

first_line=$(sed -n '1p' "$message_file")
case "$first_line" in
  v[0-9]*.[0-9]*.[0-9]*:*) ;;
  *)
    temporary_message="${message_file}.versioned"
    printf 'v%s: %s\n' "$next_version" "$first_line" > "$temporary_message"
    sed '1d' "$message_file" >> "$temporary_message"
    mv "$temporary_message" "$message_file"
    ;;
esac
