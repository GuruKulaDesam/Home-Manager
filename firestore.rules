rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validVault(vaultId) {
      return vaultId.matches('^[A-Za-z0-9_-]{43}$');
    }

    match /familyVaults/{vaultId}/state/{stateId} {
      allow get: if request.auth != null && validVault(vaultId) && stateId == 'current';
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && validVault(vaultId)
        && stateId == 'current'
        && request.resource.data.keys().hasOnly(['schemaVersion', 'state', 'revision', 'deviceId', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.state is map
        && request.resource.data.revision is int
        && request.resource.data.deviceId is string;
    }

    match /familyVaults/{vaultId}/googleContacts/{contactId} {
      allow get, list: if request.auth != null && validVault(vaultId);
      allow delete: if false;
      allow create, update: if request.auth != null
        && validVault(vaultId)
        && request.resource.data.keys().hasOnly(['id', 'scope', 'name', 'category', 'phone', 'email', 'hours', 'source', 'sourceRef', 'personId', 'importedAt'])
        && request.resource.data.id == contactId
        && request.resource.data.source == 'Google Contacts'
        && request.resource.data.name is string
        && request.resource.data.sourceRef is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
