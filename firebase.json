{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "/assets/models/**",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" },
          { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
        ]
      },
      {
        "source": "/vendor/wllama/esm/wasm/**",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" },
          { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "private-data/**",
      "vendor/wllama/assets/**",
      "vendor/wllama/cpp/**",
      "vendor/wllama/guides/**",
      "vendor/wllama/scripts/**",
      "vendor/wllama/src/**",
      "test-results/**",
      "tests/**",
      "inputs/**",
      "docs/**",
      "android-companion/**",
      "scripts/**",
      "**/*.idsig",
      "*.log",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "README.md",
      "CONSOLIDATION.md",
      "CNAME"
    ]
  }
}
